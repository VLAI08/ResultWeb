{% extends 'modern/base.html.twig' %}
{% block title %}Inicio - Resultados en Línea{% endblock %}
{% block content %}
{% set sessionUser = app.session.get('user') %}
<div class="greeting-hero">
    <div class="d-flex align-items-center gap-3 position-relative" style="z-index:1;">
        <span class="gh-avatar"><i class="bi bi-person-heart"></i></span>
        <div>
            <h2>Hola, {{ sessionUser.type == 'company' ? sessionUser.names : (sessionUser.names ~ ' ' ~ sessionUser.lastnames) }} 👋</h2>
            <p>{% if sessionUser.type == 'company' %}Consulta y descarga los resultados de tus pacientes{% else %}Consulta y descarga tus resultados de laboratorio{% endif %}</p>
        </div>
    </div>
    <span class="gh-date position-relative" style="z-index:1;" id="greeting-date"></span>
    <svg class="gh-ecg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
        <path class="ecg-line" d="M0,50 H90 L105,50 L115,18 L132,82 L146,40 L158,50 H250 L265,50 L275,12 L295,88 L310,50 H400 L415,50 L425,22 L440,72 L455,50 H600"
              fill="none" stroke="#7FE0E8" stroke-width="2" stroke-linecap="round"/>
    </svg>
</div>
<div class="page-head">
    <div>
        <h1><span class="head-icon"><i class="bi bi-clipboard2-pulse"></i></span>{% if sessionUser.type == 'company' %}Consultar resultados{% else %}Mis resultados{% endif %}</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item active" aria-current="page">Inicio</li></ol></nav>
    </div>
</div>
{% if sessionUser.type != 'admin' %}
<div class="row g-3 mb-3 stagger" id="stats-row">
    {% if sessionUser.type == 'company' %}
    <div class="col-6 col-md-4">
        <div class="card"><div class="card-body py-3 stat-card">
            <div class="stat-icon blue"><i class="bi bi-journal-text"></i></div>
            <div><div class="fs-4 fw-bold" id="stat-requests">—</div><div class="small text-muted">Solicitudes (30 días)</div></div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card"><div class="card-body py-3 stat-card">
            <div class="stat-icon green"><i class="bi bi-people"></i></div>
            <div><div class="fs-4 fw-bold" id="stat-patients">—</div><div class="small text-muted">Pacientes</div></div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card"><div class="card-body py-3 stat-card">
            <div class="stat-icon purple"><i class="bi bi-clipboard2-pulse"></i></div>
            <div><div class="fs-4 fw-bold" id="stat-exams">—</div><div class="small text-muted">Exámenes</div></div>
        </div></div>
    </div>
    {% else %}
    <div class="col-6 col-md-3">
        <div class="card"><div class="card-body py-3 stat-card">
            <div class="stat-icon blue"><i class="bi bi-journal-text"></i></div>
            <div><div class="fs-4 fw-bold" id="stat-requests">—</div><div class="small text-muted">Solicitudes</div></div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card"><div class="card-body py-3 stat-card">
            <div class="stat-icon purple"><i class="bi bi-clipboard2-pulse"></i></div>
            <div><div class="fs-4 fw-bold" id="stat-exams">—</div><div class="small text-muted">Exámenes</div></div>
        </div></div>
    </div>
    {% endif %}
</div>
{% endif %}
<div class="row g-3">
    <div class="col-12">
        <ul class="nav nav-pills mb-3" id="mainTabs">
            {% if sessionUser.type != 'company' %}
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-mine"><i class="bi bi-file-earmark-text me-1"></i>Mis resultados</button></li>
            {% endif %}
            {% if sessionUser.type == 'admin' or sessionUser.type == 'company' %}
            <li class="nav-item"><button class="nav-link {% if sessionUser.type == 'company' %}active{% endif %}" data-bs-toggle="pill" data-bs-target="#tab-search"><i class="bi bi-search me-1"></i>Buscar resultados</button></li>
            {% endif %}
        </ul>
    </div>

    {% if sessionUser.type != 'company' %}
    <div class="col-12 tab-pane fade show active" id="tab-mine">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="bi bi-file-text text-primary me-1"></i> Mis resultados</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group-icon" style="width: 250px;">
                        <i class="bi bi-funnel"></i>
                        <input type="text" class="form-control form-control-sm" id="mine-search" placeholder="Filtrar solicitud, examen o empresa...">
                    </div>
                    <button class="btn btn-sm btn-outline-primary" id="btn-refresh-mine" title="Actualizar listado"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mob-cards" id="mine-table">
                        <thead class="v-heading">
                            <tr><th>Solicitud</th><th>Fecha recepción</th><th>Exámenes</th><th>Empresa</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div class="text-center text-muted py-5 d-none" id="mine-empty">
                        <span class="empty-state"><i class="bi bi-file-text"></i>No tiene resultados disponibles.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if sessionUser.type == 'admin' or sessionUser.type == 'company' %}
    <div class="col-12 tab-pane fade {% if sessionUser.type == 'company' %}show active{% endif %}" id="tab-search">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-search text-primary me-1"></i> Búsqueda de pacientes</div>
            <div class="card-body">
                <form id="search-form" class="row g-2">
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="identification_type">
                            <option value="">Tipo doc.</option>
                            {% for t in identification_types %}
                            <option value="{{ t.valor }}">{{ t.titulo }} ({{ t.valor }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="identification_number" placeholder="Identificación"></div>
                    <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="name" placeholder="Nombre"></div>
                    <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="last_name" placeholder="Apellido"></div>
                    <div class="col-md-2"><input type="date" class="form-control form-control-sm" name="start_date"></div>
                    <div class="col-md-2"><input type="date" class="form-control form-control-sm" name="end_date"></div>
                    <div class="col-md-12 d-flex gap-2">
                        <button class="btn btn-primary btn-sm" type="submit" id="search-btn"><i class="bi bi-search"></i> Buscar</button>
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="btn-clear-search">Limpiar</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mob-cards" id="search-table">
                        <thead class="v-heading">
                            <tr><th>Identificación</th><th>Nombre</th><th>Teléfono</th><th>Dirección</th><th></th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div class="text-center text-muted py-5 d-none" id="search-empty">
                        <span class="empty-state"><i class="bi bi-search"></i>Realice una búsqueda para ver resultados.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Modal selector de solicitudes -->
<div class="modal fade" id="requests-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modal-icon"><i class="bi bi-journal-text"></i></span>Solicitudes disponibles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="requests-list" style="max-height: 60vh; overflow-y: auto;"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal detalle de resultados -->
<div class="modal fade" id="detail-modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detail-body"></div>
            <div class="modal-footer">
                <a href="#" class="btn btn-success" id="detail-pdf"><i class="bi bi-file-earmark-pdf"></i> Descargar PDF</a>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
{% set sessionUser = app.session.get('user') %}
<script>
(function () {
    var heroDate = document.getElementById('greeting-date');
    if (heroDate) {
        try { heroDate.innerHTML = '<i class="bi bi-calendar3 me-1"></i>' + new Date().toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }); } catch (e) {}
    }
    // Estadísticas del dashboard según el perfil
    var statsRow = document.getElementById('stats-row');
    if (statsRow) {
        window.apiFetch('/api/dashboard', { silent: true })
            .then(function (d) {
                function fmt(n) {
                    n = n || 0;
                    if (n >= 1000000) { return (n / 1000000).toFixed(1).replace('.', ',') + ' M'; }
                    if (n >= 1000) { return (n / 1000).toFixed(1).replace('.', ',') + ' k'; }
                    return String(n);
                }
                var el = document.getElementById('stat-requests');
                if (el) { el.textContent = fmt(d.requests); }
                el = document.getElementById('stat-patients');
                if (el) { el.textContent = fmt(d.patients); }
                el = document.getElementById('stat-exams');
                if (el) { el.textContent = fmt(d.exams); }
            })
            .catch(function () {});
    }

    function downloadPdf(requestCode, isPrevalidated, url, btn) {
        if (btn) { btn.disabled = true; }
        window.apiFetch('/valid_result?_solicitud=' + encodeURIComponent(requestCode), { silent: true })
            .then(function (res) {
                if (res.state === 1) {
                    var q = '?prevalidated=' + (isPrevalidated ? '1' : '0');
                    if (url && url !== '' && url !== 'no') { q += '&url=' + encodeURIComponent(url); }
                    window.open('/result/pdf/' + encodeURIComponent(requestCode) + q, '_blank');
                } else {
                    window.showToast(res.msg || 'No puede descargar este resultado, debe estar al día con el pago.', 'warning');
                }
            })
            .catch(function () { window.showToast('Error validando el resultado.', 'danger'); })
            .finally(function () { if (btn) { btn.disabled = false; } });
    }

    function openDetail(requestCode, prevalidated) {
        var q = prevalidated !== undefined && prevalidated !== '' ? '?prevalidated=' + prevalidated : '';
        window.apiFetch('/result/detail/' + encodeURIComponent(requestCode) + q, { silent: true })
            .then(function (d) {
                if (d.message) { window.showToast(d.message, 'warning'); return; }
                var html = '';
                if (d.prevalidated) {
                    html += '<div class="alert alert-warning py-2 mb-3"><i class="bi bi-exclamation-triangle me-1"></i><b>Validado Preliminar</b> — Resultados pendientes de validación definitiva.</div>';
                }
                html += '<div class="detail-patient"><table style="width:100%"><tbody>' +
                    '<tr><td class="dp-label">Paciente</td><td class="dp-value">' + window.esc(d.patient_name) + '</td>' +
                    '<td class="dp-label">Solicitud</td><td class="dp-value">' + window.esc(d.request_code) + '</td></tr>' +
                    '<tr><td class="dp-label">Identificación</td><td class="dp-value">' + window.esc(d.identification_type + ' ' + d.identification_number) + '</td>' +
                    '<td class="dp-label">Fecha</td><td class="dp-value">' + window.esc(d.reception_date) + '</td></tr>' +
                    '<tr><td class="dp-label">Edad</td><td class="dp-value">' + window.esc(d.age + ' ' + d.age_unit) + '</td>' +
                    '<td class="dp-label">Empresa</td><td class="dp-value">' + window.esc(d.client_name) + '</td></tr></tbody></table></div>';
                (d.descriptive_texts || []).forEach(function (dt) {
                    html += '<div class="detail-exam mb-3"><div class="detail-exam-header">' +
                        '<div class="detail-exam-name">' + window.esc(dt.exam_name) + '</div></div>' +
                        '<div class="detail-exam-body"><div class="detail-ref" style="white-space: pre-line;">' + window.esc(dt.descriptive_text) + '</div></div></div>';
                });
                d.sections.forEach(function (section) {
                    html += '<div class="detail-section"><div class="detail-section-title"><i class="bi bi-folder2-open me-1"></i>' + window.esc(section.name) + '</div>';
                    section.exams.forEach(function (exam) {
                        html += '<div class="detail-exam"><div class="detail-exam-header">' +
                            '<div class="detail-exam-name">' + window.esc(exam.exam_name) + '</div>';
                        if (exam.processing_date || exam.validation_date) {
                            html += '<div class="detail-exam-meta">';
                            if (exam.processing_date) html += 'Procesado: ' + window.esc(exam.processing_date + (exam.processing_time ? ' ' + exam.processing_time : ''));
                            if (exam.validation_date) html += (exam.processing_date ? ' &nbsp;·&nbsp; ' : '') + 'Validado: ' + window.esc(exam.validation_date + (exam.validation_time ? ' ' + exam.validation_time : ''));
                            html += '</div>';
                        }
                        html += '</div><div class="detail-exam-body"><table class="detail-table"><tbody>';
                        exam.details.forEach(function (det) {
                            if (det.ima_result) { html += '<tr><td colspan="3" class="detail-meta-note"><i class="bi bi-info-circle me-1"></i>' + window.esc(det.ima_result) + '</td></tr>'; }
                            html += '<tr><td class="dt-analito" style="width:55%">' + window.esc(det.analito) + '</td>' +
                                '<td class="dt-result" style="width:20%">' + window.esc(det.result) + '</td>' +
                                '<td class="dt-units" style="width:25%">' + window.esc(det.units) + '</td></tr>';
                        });
                        html += '</tbody></table></div></div>';
                    });
                    html += '</div>';
                });
                document.getElementById('detail-title').innerHTML = '<span class="modal-icon"><i class="bi bi-journal-check"></i></span>Solicitud <span class="mono">' + window.esc(d.request_code) + '</span>';
                document.getElementById('detail-body').innerHTML = html;
                var pdf = document.getElementById('detail-pdf');
                pdf.onclick = function (e) { e.preventDefault(); downloadPdf(requestCode, d.prevalidated, d.exams, pdf); };
                new bootstrap.Modal(document.getElementById('detail-modal')).show();
            })
            .catch(function () { window.showToast('Error consultando el detalle.', 'danger'); });
    }

    var lastMine = [];
    function renderMine(items) {
        var searchEl = document.getElementById('mine-search');
        var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
        if (q !== '') {
            items = items.filter(function (r) {
                return ((r.request_code || '') + ' ' + (r.exams || '') + ' ' + (r.client_code || '')).toLowerCase().indexOf(q) !== -1;
            });
        }
        var tbody = document.querySelector('#mine-table tbody');
        tbody.innerHTML = '';
        document.getElementById('mine-empty').classList.toggle('d-none', items.length > 0);
        items.forEach(function (r) {
            var tr = document.createElement('tr');
            tr.innerHTML = '<td data-label="Solicitud" class="fw-semibold mono">' + window.esc(r.request_code) + '</td>' +
                '<td data-label="Fecha recepción">' + window.esc(r.reception_date) + '</td>' +
                '<td data-label="Exámenes">' + window.esc(r.exams) + '</td>' +
                '<td data-label="Empresa">' + window.esc(r.client_code) + '</td>' +
                '<td data-label="Estado">' + (r.prevalidated ? '<span class="badge badge-soft-warning">Validado Preliminar</span>' : '<span class="badge badge-soft-success">Validado</span>') + '</td>' +
                '<td class="text-end"><button class="btn btn-sm btn-outline-primary" title="Ver detalle del resultado" data-code="' + window.esc(r.request_code) + '" data-prevalidated="' + (r.prevalidated ? '1' : '0') + '" data-url="' + window.esc(r.url || 'no') + '"><i class="bi bi-eye"></i> Ver</button>' +
                '<button class="btn btn-sm btn-outline-success ms-1" title="Descargar PDF" data-pdf="' + window.esc(r.request_code) + '" data-prevalidated="' + (r.prevalidated ? '1' : '0') + '" data-url="' + window.esc(r.url || 'no') + '"><i class="bi bi-download"></i> PDF</button></td>';
            tbody.appendChild(tr);
        });
    }

    function loadMine() {
        window.apiFetch('/resultCrud', { silent: true })
            .then(function (res) {
                lastMine = res.items || [];
                try { localStorage.setItem('resultsCount', String(lastMine.length)); } catch (e) {}
                renderMine(lastMine);
            })
            .catch(function () {});
    }

    var tbody = document.querySelector('#mine-table tbody');
    if (tbody) {
        tbody.addEventListener('click', function (e) {
            var btn = e.target.closest('button');
            if (!btn) { return; }
            if (btn.dataset.code) { openDetail(btn.dataset.code, btn.dataset.prevalidated); }
            if (btn.dataset.pdf) { downloadPdf(btn.dataset.pdf, btn.dataset.prevalidated === '1', btn.dataset.url, btn); }
        });
        loadMine();
    }
    var refresh = document.getElementById('btn-refresh-mine');
    if (refresh) { refresh.addEventListener('click', loadMine); }

    var mineSearch = document.getElementById('mine-search');
    if (mineSearch) { mineSearch.addEventListener('input', function () { renderMine(lastMine); }); }

    var searchForm = document.getElementById('search-form');
    if (searchForm) {
        var sTable = document.querySelector('#search-table tbody');
        searchForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var btn = document.getElementById('search-btn');
            var q = new URLSearchParams(new FormData(searchForm));
            window.setLoading(btn, true, 'Buscando...');
            window.apiFetch('/results/labs?' + q.toString())
                .then(function (res) {
                    sTable.innerHTML = '';
                    document.getElementById('search-empty').classList.toggle('d-none', (res.items || []).length > 0);
                    if (res.error) { window.showToast(res.error, 'warning'); }
                    (res.items || []).forEach(function (p) {
                        var tr = document.createElement('tr');
                        tr.innerHTML = '<td data-label="Identificación">' + window.esc(p.identification_number) + '</td>' +
                            '<td data-label="Paciente" class="fw-semibold">' + window.esc(p.full_name) + '</td>' +
                            '<td data-label="Teléfono">' + window.esc(p.phone) + '</td>' +
                            '<td data-label="Dirección">' + window.esc(p.address) + '</td>' +
                            '<td class="text-end"><button class="btn btn-sm btn-outline-primary" data-search="' + window.esc(p.identification_number) + '|' + window.esc(p.identification_type) + '"><i class="bi bi-search"></i> Ver solicitudes</button></td>';
                        tr.querySelector('button').addEventListener('click', function () {
                            var parts = this.dataset.search.split('|');
                            var q2 = new URLSearchParams({ identification: parts[0], type_doc: parts[1] });
                            window.apiFetch('/resultCrud?' + q2.toString(), { silent: true })
                                .then(function (res) {
                                    if (!res.items || !res.items.length) { window.showToast('El paciente no tiene solicitudes disponibles.', 'warning'); return; }
                                    var list = document.getElementById('requests-list');
                                    var html = '<div class="list-group list-group-flush">';
                                    res.items.forEach(function (r) {
                                        html += '<a href="#" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" data-req="' + window.esc(r.request_code) + '">' +
                                            '<span class="stat-icon blue" style="width:40px;height:40px;font-size:1.05rem;"><i class="bi bi-file-earmark-text"></i></span>' +
                                            '<span class="flex-grow-1"><span class="d-block fw-semibold">Solicitud ' + window.esc(r.request_code) + '</span>' +
                                            '<span class="d-block small text-muted">' + window.esc(r.reception_date) + '</span></span>' +
                                            '<i class="bi bi-chevron-right text-muted"></i></a>';
                                    });
                                    html += '</div>';
                                    list.innerHTML = html;
                                    var modal = new bootstrap.Modal(document.getElementById('requests-modal'));
                                    list.querySelectorAll('a[data-req]').forEach(function (a) {
                                        a.addEventListener('click', function (e) {
                                            e.preventDefault();
                                            modal.hide();
                                            openDetail(this.dataset.req);
                                        });
                                    });
                                    modal.show();
                                })
                                .catch(function () {});
                        });
                        sTable.appendChild(tr);
                    });
                })
                .catch(function () {})
                .finally(function () { window.setLoading(btn, false); });
        });
        document.getElementById('btn-clear-search').addEventListener('click', function () { searchForm.reset(); sTable.innerHTML = ''; });
    }
})();
</script>
{% endblock %}
