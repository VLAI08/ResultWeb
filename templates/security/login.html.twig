{% extends 'modern/base.html.twig' %}
{% block title %}Ingreso - Resultados en Línea{% endblock %}
{% block body_only %}
<div class="login-bg">
    <div class="login-card card shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <img src="{{ asset('static/images/logo_sta.png') }}" alt="Logo" style="max-height: 64px;" onerror="this.style.display='none'">
                <h1 class="h4 mt-3 mb-0">Resultados en Línea</h1>
                <p class="text-muted small">Laboratorio SantaLucia</p>
            </div>

            <div class="alert alert-danger d-none" id="loginAlert"></div>

            <form id="login-form" method="post" action="{{ path('security_login_check') }}">
                <div class="mb-3">
                    <label for="_identification_type" class="form-label">Tipo de documento</label>
                    <select class="form-select" id="_identification_type" name="_identification_type" required>
                        {% if identification_types is defined and identification_types %}
                            {% for t in identification_types %}
                            <option value="{{ t.valor }}" {% if t.valor == 'CC' %}selected{% endif %}>{{ t.titulo }} ({{ t.valor }})</option>
                            {% endfor %}
                        {% else %}
                            <option value="CC" selected>CC - Cédula de Ciudadanía</option>
                            <option value="CE">CE - Cédula de Extranjería</option>
                            <option value="TI">TI - Tarjeta de Identidad</option>
                            <option value="PA">PA - Pasaporte</option>
                            <option value="NI">NI - Nit (Empresa)</option>
                        {% endif %}
                    </select>
                </div>
                <div class="mb-3">
                    <label for="_username" class="form-label">Número de identificación</label>
                    <input type="text" class="form-control" id="_username" name="_username" placeholder="Ej: 1012345678" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="_password" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="_password" name="_password" placeholder="Contraseña" required>
                    <div class="form-text">
                        <b>NOTA:</b> Su contraseña por defecto es su número de identificación. Recuerde que usted debe
                        cambiar su contraseña para GARANTIZAR la confidencialidad de los resultados de laboratorio.
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100" id="login-submit">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="{{ path('reset_password_page') }}" class="small">¿Olvidó su contraseña?</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
    var loginForm = document.getElementById('login-form');
    var alertBox = document.getElementById('loginAlert');
    function showError(msg) {
        alertBox.textContent = msg;
        alertBox.classList.remove('d-none');
    }
    loginForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('login-submit');
        btn.disabled = true;
        var data = new URLSearchParams(new FormData(loginForm));
        fetch(loginForm.action, { method: 'POST', body: data })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.state === '111') {
                    window.location.href = '{{ path('root') }}';
                } else {
                    showError(res.message || 'Usuario o contraseña incorrectos');
                    btn.disabled = false;
                }
            })
            .catch(function () {
                showError('No se pudo conectar con el servidor. Intente nuevamente.');
                btn.disabled = false;
            });
    });
})();
</script>
{% endblock %}
