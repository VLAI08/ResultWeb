{% extends 'modern/base.html.twig' %}
{% block title %}Recuperar contraseña - Resultados en Línea{% endblock %}
{% block body_only %}
<div class="login-bg">
    <div class="login-card card shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <img src="{{ asset('static/images/logo_sta.png') }}" alt="Logo" style="max-height: 64px;" onerror="this.style.display='none'">
                <h1 class="h4 mt-3 mb-0">Recuperar contraseña</h1>
                <p class="text-muted small">Laboratorio SantaLucia</p>
            </div>

            <div class="alert alert-danger d-none" id="rpAlert"></div>

            <!-- Paso 1: correo -->
            <div id="rp-step-email">
                <div class="info-box mb-3 rounded p-3 bg-light small text-muted">
                    Ingresa tu correo electrónico y te enviaremos un código de verificación con validez de
                    <strong>10 minutos</strong>. Luego podrás establecer una nueva contraseña de forma segura.
                </div>
                <div class="mb-3">
                    <label for="rp-email" class="form-label">Correo electrónico</label>
                    <input type="email" class="form-control" id="rp-email" required>
                </div>
                <button type="button" class="btn btn-primary w-100" id="rp-send"><span id="rp-send-label">Enviar código</span></button>
                <div class="text-center mt-3">
                    <a href="{{ path('security_login') }}" class="small">Ir al login</a>
                </div>
            </div>

            <!-- Paso 2: código + nueva contraseña -->
            <div id="rp-step-code" class="d-none">
                <div class="mb-3">
                    <label for="rp-code" class="form-label">Código de verificación</label>
                    <input type="text" class="form-control" id="rp-code" maxlength="6" required>
                    <div class="form-text small">Revisa tu correo: el código tiene validez de 10 minutos.</div>
                </div>
                <div class="mb-3">
                    <label for="rp-password" class="form-label">Nueva contraseña</label>
                    <input type="password" class="form-control" id="rp-password" minlength="4" required>
                </div>
                <div class="mb-3">
                    <label for="rp-confirm" class="form-label">Confirmar contraseña</label>
                    <input type="password" class="form-control" id="rp-confirm" required>
                </div>
                <button type="button" class="btn btn-success w-100" id="rp-submit"><span id="rp-submit-label">Cambiar contraseña</span></button>
                <div class="text-center mt-3">
                    <a href="{{ path('security_login') }}" class="small">Ir al login</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
    var alertBox = document.getElementById('rpAlert');
    var stepEmail = document.getElementById('rp-step-email');
    var stepCode = document.getElementById('rp-step-code');

    function showError(msg) {
        alertBox.textContent = msg;
        alertBox.classList.remove('d-none');
    }
    function clearError() { alertBox.classList.add('d-none'); }

    function setLoading(btn, on, label) {
        btn.disabled = on;
        if (on) {
            btn.dataset.label = document.getElementById(btn.id + '-label').textContent;
            document.getElementById(btn.id + '-label').textContent = label;
        } else if (btn.dataset.label) {
            document.getElementById(btn.id + '-label').textContent = btn.dataset.label;
        }
    }

    document.getElementById('rp-send').addEventListener('click', function () {
        var email = document.getElementById('rp-email').value.trim();
        clearError();
        if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            showError('Ingrese un correo electrónico válido.');
            return;
        }
        var btn = this;
        setLoading(btn, true, 'Enviando...');
        var data = new URLSearchParams({ email: email });
        fetch('{{ path('request_reset_password') }}', { method: 'POST', body: data })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                setLoading(btn, false);
                if (!res.success) { showError(res.message || 'No se pudo enviar el código.'); return; }
                stepEmail.classList.add('d-none');
                stepCode.classList.remove('d-none');
            })
            .catch(function () {
                setLoading(btn, false);
                showError('No se pudo conectar con el servidor. Intente nuevamente.');
            });
    });

    document.getElementById('rp-submit').addEventListener('click', function () {
        var email = document.getElementById('rp-email').value.trim();
        var code = document.getElementById('rp-code').value.trim();
        var password = document.getElementById('rp-password').value;
        var confirm = document.getElementById('rp-confirm').value;
        clearError();
        if (code === '' || code.length < 6) { showError('Ingrese el código de verificación de 6 dígitos.'); return; }
        if (password === '') { showError('Ingrese la nueva contraseña.'); return; }
        if (password !== confirm) { showError('Las contraseñas no coinciden. Por favor, verifica.'); return; }
        var btn = this;
        setLoading(btn, true, 'Procesando...');
        var data = new URLSearchParams({ email: email, code: code, password: password });
        fetch('{{ path('reset_password') }}', { method: 'POST', body: data })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                setLoading(btn, false);
                if (!res.success) { showError(res.message || 'No se pudo cambiar la contraseña.'); return; }
                alertBox.classList.remove('d-none', 'alert-danger');
                alertBox.classList.add('alert-success');
                alertBox.textContent = 'Se ha actualizado la contraseña correctamente';
                setTimeout(function () { window.location.href = '{{ path('security_login') }}'; }, 1500);
            })
            .catch(function () {
                setLoading(btn, false);
                showError('No se pudo conectar con el servidor. Intente nuevamente.');
            });
    });
})();
</script>
{% endblock %}
