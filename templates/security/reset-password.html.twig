{% extends 'modern/base.html.twig' %}
{% block title %}Recuperar contraseña - Resultados en Línea{% endblock %}
{% block body_only %}
<div class="auth-shell">
    <aside class="auth-brand">
        <img src="{{ asset('static/images/logo_sta.png') }}" alt="Laboratorio SantaLucia" class="ab-logo">
        <svg class="ab-ecg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,50 H90 L105,50 L115,18 L132,82 L146,40 L158,50 H250 L265,50 L275,12 L295,88 L310,50 H400 L415,50 L425,22 L440,72 L455,50 H600"
                  fill="none" stroke="rgba(15,163,177,.25)" stroke-width="1.5"/>
            <path class="ecg-line" d="M0,50 H90 L105,50 L115,18 L132,82 L146,40 L158,50 H250 L265,50 L275,12 L295,88 L310,50 H400 L415,50 L425,22 L440,72 L455,50 H600"
                  fill="none" stroke="#0FA3B1" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <h1 class="ab-title">¿Problemas<br><span>para ingresar?</span></h1>
        <p class="ab-sub">Recupera el acceso a tu cuenta en dos pasos simples y seguros. Tu información médica siempre protegida.</p>
        <div class="ab-bullets">
            <div class="ab-bullet"><i class="bi bi-envelope-check"></i><span>Te enviamos un código de verificación a tu correo</span></div>
            <div class="ab-bullet"><i class="bi bi-stopwatch"></i><span>El código tiene una validez de 10 minutos</span></div>
            <div class="ab-bullet"><i class="bi bi-shield-lock"></i><span>Establece una nueva contraseña de forma segura</span></div>
        </div>
        <div class="ab-contact">
            <span><i class="bi bi-telephone me-1"></i>(601) 743 1226</span>
            <span><i class="bi bi-geo-alt me-1"></i>labsantalucia.com.co</span>
        </div>
    </aside>

    <main class="auth-panel">
        <div class="auth-topbar w-100">
            <img src="{{ asset('static/images/logo_sta.png') }}" alt="SantaLucia">
            <span>Resultados en Línea</span>
        </div>
        <div class="auth-card">
            <div class="text-center mb-4">
                <div class="auth-logo auth-logo-icon"><i class="bi bi-key"></i></div>
                <h1 class="h4 auth-title mt-3 mb-1">Recuperar contraseña</h1>
                <p class="auth-sub mb-0">Recupera el acceso a tu cuenta de forma segura</p>
            </div>
            <input type="hidden" id="rp-csrf" value="{{ csrf_token('reset_pw') }}">
            <input type="text" name="website" id="rp-website" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="steps">
                <span class="step-dot active" id="step-dot-1"></span>
                <span class="step-bar" id="step-bar-1"></span>
                <span class="step-dot" id="step-dot-2"></span>
            </div>

            <div class="alert alert-danger d-none" id="rpAlert"></div>

            <!-- Paso 1: correo -->
            <div id="rp-step-email">
                <div class="mb-3">
                    <label for="rp-email" class="form-label small">Correo electrónico</label>
                    <div class="input-group-icon">
                        <i class="bi bi-envelope"></i>
                        <input type="email" class="form-control" id="rp-email" placeholder="tucorreo@ejemplo.com" required>
                    </div>
                    <div class="form-text small mt-2"><i class="bi bi-info-circle me-1"></i>Te enviaremos un código de verificación con validez de <strong>10 minutos</strong>.</div>
                </div>
                <button type="button" class="btn btn-primary w-100 py-2" id="rp-send"><span id="rp-send-label">Enviar código</span></button>
                <div class="text-center mt-3">
                    <a href="{{ path('security_login') }}" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión</a>
                </div>
            </div>

            <!-- Paso 2: código + nueva contraseña -->
            <div id="rp-step-code" class="d-none">
                <div class="mb-3">
                    <label for="rp-code" class="form-label small">Código de verificación</label>
                    <div class="input-group-icon">
                        <i class="bi bi-hash"></i>
                        <input type="text" class="form-control mono" id="rp-code" maxlength="6" placeholder="6 dígitos" style="letter-spacing:.4em;" required>
                    </div>
                    <div class="form-text small">Revisa tu correo: el código tiene validez de 10 minutos.</div>
                </div>
                <div class="mb-3">
                    <label for="rp-password" class="form-label small">Nueva contraseña</label>
                    <div class="input-group-icon">
                        <i class="bi bi-lock"></i>
                        <input type="password" class="form-control" id="rp-password" minlength="8" placeholder="Mínimo 8 caracteres" required>
                    </div>
                    <div class="pw-meter"><div id="rp-meter-bar"></div></div>
                    <div class="pw-meter-label" id="rp-meter-label">Mínimo 8 caracteres. Use mayúsculas, números y símbolos para mayor seguridad.</div>
                </div>
                <div class="mb-3">
                    <label for="rp-confirm" class="form-label small">Confirmar contraseña</label>
                    <div class="input-group-icon">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password" class="form-control" id="rp-confirm" placeholder="Repite la nueva contraseña" required>
                    </div>
                </div>
                <button type="button" class="btn btn-success w-100 py-2" id="rp-submit"><span id="rp-submit-label">Cambiar contraseña</span></button>
                <div class="text-center mt-3">
                    <a href="{{ path('security_login') }}" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión</a>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
    var alertBox = document.getElementById('rpAlert');
    var stepEmail = document.getElementById('rp-step-email');
    var stepCode = document.getElementById('rp-step-code');

    // Medidor de fuerza de la nueva contraseña
    var rpPw = document.getElementById('rp-password');
    if (rpPw) {
        rpPw.addEventListener('input', function () {
            var v = rpPw.value, s = 0;
            if (v.length >= 8) { s++; }
            if (v.length >= 12) { s++; }
            if (/[A-Z]/.test(v) && /[a-z]/.test(v)) { s++; }
            if (/\d/.test(v)) { s++; }
            if (/[^A-Za-z0-9]/.test(v)) { s++; }
            s = Math.min(4, s);
            var bar = document.getElementById('rp-meter-bar');
            var lbl = document.getElementById('rp-meter-label');
            if (!bar || !lbl) { return; }
            var conf = { 0: ['0%', '', ''], 1: ['25%', 'var(--danger)', 'Débil'], 2: ['50%', 'var(--warning)', 'Aceptable'], 3: ['75%', 'var(--brand-500)', 'Buena'], 4: ['100%', 'var(--success)', 'Excelente'] }[s];
            bar.style.width = conf[0];
            bar.style.background = conf[1];
            lbl.textContent = v === '' ? 'Mínimo 8 caracteres. Use mayúsculas, números y símbolos para mayor seguridad.' : 'Seguridad: ' + conf[2];
        });
    }

    function showError(msg) {
        alertBox.textContent = msg;
        alertBox.classList.remove('d-none', 'alert-success');
        alertBox.classList.add('alert-danger');
    }
    function clearError() { alertBox.classList.add('d-none'); }

    function setLoading(btn, on, label) {
        btn.disabled = on;
        if (on) {
            btn.dataset.label = document.getElementById(btn.id + '-label').textContent;
            document.getElementById(btn.id + '-label').textContent = label;
        } else if (btn.dataset.label) {
            document.getElementById(btn.id + '-label').textContent = btn.dataset.label;
        }
    }

    function gotoStep2() {
        stepEmail.classList.add('d-none');
        stepCode.classList.remove('d-none');
        document.getElementById('step-bar-1').classList.add('done');
        document.getElementById('step-dot-2').classList.add('active');
        setTimeout(function () { document.getElementById('rp-code').focus(); }, 150);
    }

    document.getElementById('rp-send').addEventListener('click', function () {
        var email = document.getElementById('rp-email').value.trim();
        clearError();
        if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            showError('Ingrese un correo electrónico válido.');
            return;
        }
        var btn = this;
        setLoading(btn, true, 'Enviando...');
        var data = new URLSearchParams({ email: email, website: document.getElementById('rp-website').value, _csrf_token: document.getElementById('rp-csrf').value });
        fetch('{{ path('request_reset_password') }}', { method: 'POST', body: data })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                setLoading(btn, false);
                if (!res.success) { showError(res.message || 'No se pudo enviar el código.'); return; }
                gotoStep2();
            })
            .catch(function () {
                setLoading(btn, false);
                showError('No se pudo conectar con el servidor. Intente nuevamente.');
            });
    });

    document.getElementById('rp-submit').addEventListener('click', function () {
        var email = document.getElementById('rp-email').value.trim();
        var code = document.getElementById('rp-code').value.trim();
        var password = document.getElementById('rp-password').value;
        var confirm = document.getElementById('rp-confirm').value;
        clearError();
        if (code === '' || code.length < 6) { showError('Ingrese el código de verificación de 6 dígitos.'); return; }
        if (password === '') { showError('Ingrese la nueva contraseña.'); return; }
        if (password.length < 8) { showError('La contraseña debe tener al menos 8 caracteres.'); return; }
        if (password !== confirm) { showError('Las contraseñas no coinciden. Por favor, verifica.'); return; }
        var btn = this;
        setLoading(btn, true, 'Procesando...');
        var data = new URLSearchParams({ email: email, code: code, password: password, _csrf_token: document.getElementById('rp-csrf').value });
        fetch('{{ path('reset_password') }}', { method: 'POST', body: data })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                setLoading(btn, false);
                if (!res.success) { showError(res.message || 'No se pudo cambiar la contraseña.'); return; }
                alertBox.classList.remove('d-none', 'alert-danger');
                alertBox.classList.add('alert-success');
                alertBox.innerHTML = '<i class="bi bi-check-circle me-1"></i>Se ha actualizado la contraseña correctamente';
                setTimeout(function () { window.location.href = '{{ path('security_login') }}'; }, 1500);
            })
            .catch(function () {
                setLoading(btn, false);
                showError('No se pudo conectar con el servidor. Intente nuevamente.');
            });
    });
})();
</script>
{% endblock %}
