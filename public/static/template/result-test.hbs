<!DOCTYPE html>
<html>

<head>
	<title>Some relevant title</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
		integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
	<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/barcodes/JsBarcode.code128.min.js"></script>
	<style>
		html,
		body {
			font-family: "verdana", "sans-serif";
			font-size: 1em;
		}

		.label {
			color: #000033;
			padding: 1px 3px;
			font-size: 0.95em;
			font-weight: 500;
		}

		.field {
			color: #000033;
			padding: 1px 3px;
			font-weight: 600;
			font-size: 0.75em;
		}

		td {
			color: #000033;
			padding: 0px 3px;
		}


		.seccion-title {
			margin-top: 3px;
			margin-bottom: 8px;
			font-weight: 500;
			font-size: 1.3rem;
			color: #000033;
		}

		.analito {
			width: 300px;
			white-space: nowrap;
			font-size: 0.80em;
			padding: 1px 3px;
		}

		.result {
			width: 100px;
			white-space: nowrap;
			font-size: 0.75em;
			padding: 1px 3px;
		}

		.border-top-black {
			border-top: 1px solid black !important;
		}

		.border-bottom-black {
			border-bottom: 1px solid black !important;
		}

		.print {
			widows: 12;
			page-break-after: always;
			page-break-inside: always;
		}

		.print:last-of-type {
			page-break-after: auto;
		}

		.detail-result {
			page-break-after: auto;
			page-break-inside: always;
		}


		.content {
			position: relative;
			/*top: 360px;*/
		}

		.header-logo {
			position: fixed;
			left: 0px;
			top: 0px;
			right: 0px;
			height: 200px;
		}

		.footer-logo {
			position: fixed;
			left: 0px;
			bottom: -90px;
			right: 0px;
			height: 200px;
		}

		.client-title {
			font-weight: bold;
			font-size: 1.1em;
			height: 40px !important;
		}

		.signature {
			position: fixed;
			bottom: 100px;
			right: -50px;
		}
	</style>
</head>

<body class="page1">
	<div class="row">
		<div class="col">
			<div class="content">
				{{#each sections}}
				<div class="print">
					<div class="seccion-title">{{ name }}</div>
					{{#each exams}}
					<div style="margin-bottom: 15px;" class="detail-result">
						{{#each details}}
						<div>
							<p>{{ imaResult }}</p>
							<table class="mt-1" cellspacing="2" cellpadding="2" aria-describedby="">
								<tr>
									<td class="analito">
										{{ analito }}
									</td>
									<td class="result">
										{{ result }}
									</td>
									<td class="result">
										{{ units }}
									</td>
								</tr>
							</table>
						</div>
						{{/each}}
					</div>
					{{/each}}
					<div class="signature">
						<img src="{{signature}}" style="width: 450px; height: 180px" alt="">
					</div>
				</div>

				{{/each}}
			</div>
		</div>
	</div>
</body>

</html>