<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Base automática: funciona tanto por vhost (resultados44.local) como por subdirectorio.
    RewriteCond %{REQUEST_URI}::$1 ^(/.+)(.+)::\2$
    RewriteRule ^(.*) - [E=BASE:%1]

    # Redirect to front controller if request is not a real file or dir
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule .? %{ENV:BASE}/index.php [L]

    # Pass Authorization headers to PHP
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# If you use Apache without AllowOverride All, you can copy these rules to vhost.